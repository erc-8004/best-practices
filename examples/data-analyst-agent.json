        "analyze_dataset",
        "generate_chart",
        "create_dashboard",
        "run_sql_query",
        "calculate_statistics",
        "detect_anomalies",
        "forecast_trends"
      ],
      "mcpPrompts": [
        "executive_summary",
        "detailed_analysis_report",
        "data_quality_assessment"
      ],
      "mcpResources": [
        "connected_databases",
        "historical_reports",
        "data_dictionaries",
        "visualization_templates"
      ]
    },
    {
      "name": "A2A",
      "endpoint": "https://api.insightengine.example.com/a2a",
